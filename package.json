{
  "name": "oak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Oak — learn music theory by writing music in Strudel (personal, local-first).",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26"
  },
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/content/build.ts && concurrently -k -n srv,web,cnt -c blue,green,magenta \"OAK_DEV=1 bun --watch server/src/main.ts\" \"node node_modules/vite/bin/vite.js --config app/vite.config.ts\" \"bun scripts/content/build.ts --watch\"",
    "dev:server": "OAK_DEV=1 bun --watch server/src/main.ts",
    "dev:web": "node node_modules/vite/bin/vite.js --config app/vite.config.ts",
    "build": "bun scripts/content/build.ts && bun scripts/sounds/check.ts && node node_modules/vite/bin/vite.js build --config app/vite.config.ts",
    "start": "bun server/src/main.ts --serve-dist",
    "oak": "bun run build && bun run start",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.worklet.json && tsc -p tsconfig.e2e.json && tsc -p server/src/tutor/tsconfig.json && tsc -p app/tsconfig.json && tsc -p packages/strudel/e2e/tsconfig.json && tsc -p packages/audio/e2e/tsconfig.json && bun run typecheck:packages",
    "typecheck:packages": "sh -c 'for p in packages/*/tsconfig.json; do tsc --noEmit -p \"$p\" || exit 1; done'",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "bun test --isolate",
    "test:content": "bun test --isolate content",
    "test:browser": "bun scripts/e2e-parallel.ts",
    "e2e": "bun scripts/e2e-parallel.ts",
    "e2e:serial": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:full": "bun run check && bun run e2e",
    "test:changed": "bun scripts/changed.ts test",
    "e2e:changed": "bun scripts/changed.ts e2e",
    "check:changed": "bun scripts/changed.ts check",
    "content:build": "bun scripts/content/build.ts",
    "content:new": "bun scripts/content/new.ts",
    "content:check": "bun scripts/content/check.ts",
    "theory": "bun packages/theory/src/cli.bun.ts",
    "sounds:mirror": "bun scripts/sounds/mirror.ts",
    "sounds:check": "bun scripts/sounds/check.ts",
    "tutor:smoke": "bun server/src/tutor/backends/cli/live-smoke.ts",
    "db:backup": "bun scripts/db/backup.ts",
    "postinstall": "bun scripts/check-deps.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@mdx-js/react": "3.1.1",
    "@oak/api": "workspace:*",
    "@oak/audio": "workspace:*",
    "@oak/content-kit": "workspace:*",
    "@oak/drills": "workspace:*",
    "@oak/grader": "workspace:*",
    "@oak/notation": "workspace:*",
    "@oak/pitch": "workspace:*",
    "@oak/srs": "workspace:*",
    "@oak/strudel": "workspace:*",
    "@oak/theory": "workspace:*",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@xstate/react": "6.1.0",
    "abcjs": "6.7.2",
    "acorn": "8.19.0",
    "clsx": "2.1.1",
    "hono": "4.13.17",
    "lucide-react": "1.71.0",
    "pitchy": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "signalsmith-stretch": "1.3.2",
    "superdough": "1.3.0",
    "tonal": "6.5.1",
    "ts-fsrs": "6.0.0",
    "wavesurfer.js": "8.0.5",
    "worker-timers": "8.0.34",
    "xstate": "5.33.4",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@biomejs/biome": "2.6.6",
    "@happy-dom/global-registrator": "21.0.4",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.7",
    "fast-check": "4.10.2",
    "mdast-util-to-string": "4.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "patchedDependencies": {
    "@kabelsalat/web@0.4.1": "patches/@kabelsalat%2Fweb@0.4.1.patch"
  }
}
